<mvc:View controllerName="rlcreatereservations.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core" displayBlock="true">
    <f:DynamicPage id="pageDetail" toggleHeaderOnTitleClick="true" busy="{viewModel>/busy}" busyIndicatorDelay="0">
        <f:title>
            <f:DynamicPageTitle>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" press=".onNavBack" tooltip="{i18n>backBtn}" />
                </f:navigationActions>
                <f:heading>
                    <Title text="{i18n>detailTitle}" />
                </f:heading>
                <f:actions>
                    <Button text="{i18n>approveBtn}" icon="sap-icon://accept" type="Accept" press=".onApprove" visible="{
                            path: 'detailModel>/STATO',
                            formatter: '.formatter.formatApproveButtonVisible'
                        }" />
                    <Button text="{i18n>rejectBtn}" icon="sap-icon://decline" type="Reject" press=".onReject" visible="{
                            path: 'detailModel>/STATO',
                            formatter: '.formatter.formatRejectButtonVisible'
                        }" />
                </f:actions>
                <f:snappedContent>
                    <Text text="{detailModel>/N_RICH}" />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <form:SimpleForm editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" columnsXL="2" columnsL="2" columnsM="1">
                <form:content>
                    <core:Title text="{i18n>lblHeaderData}" />
                    <Label text="{i18n>lblRsnum}" />
                    <Text text="{detailModel>/N_RICH}" />
                    <Label text="{i18n>lblStatus}" />
                    <ObjectStatus text="{
                            path: 'detailModel>/STATO',
                            formatter: '.formatter.formatStatusText'
                        }" state="{
                            path: 'detailModel>/STATO',
                            formatter: '.formatter.formatStatusState'
                        }" />
                    <core:Title text="{i18n>lblLevel1}" />
                    <Label text="{i18n>lblUtenteLiv}" />
                    <Text text="{detailModel>/UTENTE_I_LIV}" />
                    <Label text="{i18n>lblDataLiv}" />
                    <Text text="{
                        path: 'detailModel>/DATA_I_LIV',
                        formatter: '.formatter.formatIsoDate'
                    }" />
                    <Label text="{i18n>lblMotivoRif}" visible="{= ${detailModel>/MOTIVO_RIF} !== ''}" />
                    <Text text="{detailModel>/MOTIVO_RIF}" visible="{= ${detailModel>/MOTIVO_RIF} !== ''}" />
                    <core:Title text="{i18n>lblLevel2}" />
                    <Label text="{i18n>lblUtenteLiv}" />
                    <Text text="{detailModel>/UTENTE_II_LIV}" />
                    <Label text="{i18n>lblDataLiv}" />
                    <Text text="{
                        path: 'detailModel>/DATA_II_LIV',
                        formatter: '.formatter.formatIsoDate'
                    }" />
                    <Label text="{i18n>lblMotivoRif}" visible="{= ${detailModel>/MOTIVO_RIF_II} !== ''}" />
                    <Text text="{detailModel>/MOTIVO_RIF_II}" visible="{= ${detailModel>/MOTIVO_RIF_II} !== ''}" />
                </form:content>
            </form:SimpleForm>
        </f:content>
    </f:DynamicPage>
</mvc:View>